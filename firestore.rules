rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'jammy.pate@gmail.com'
          || request.auth.token.email == 'linda.a.dada@gmail.com');
    }

    match /sharedData/{document} {
      allow read, write: if isAuthorizedUser();
    }

    // Simplifi sync: the Withdrawal Plan page writes the extension key's hash; only the Cloud Function writes the snapshot.
    match /simplifi/link {
      allow read, write: if isAuthorizedUser();
    }

    match /simplifi/snapshot {
      allow read: if isAuthorizedUser();
      allow write: if false;
    }
  }
}